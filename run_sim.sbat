#!/bin/bash

#SBATCH --job-name=sim_full
#SBATCH --output=/dev/null
#SBATCH --error=/dev/null
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=20G
#SBATCH --time=10:00:00

#SBATCH --account=stats_dept1
#SBATCH --partition=standard

#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=lrcosta@umich.edu

# Capture the input argument
CONFIG_FILE=$1

if [ -z "$CONFIG_FILE" ]; then
    echo "Error: No configuration file provided."
    echo "Usage: sbatch run.sh config_xxxx.yaml"
    exit 1
fi

# Extract identifier from config_xxxx.yaml -> xxxx
CONFIG_NAME=$(basename "$CONFIG_FILE")
CONFIG_NAME="${CONFIG_NAME%.*}"      # Remove extension
CONFIG_ID="${CONFIG_NAME#config_}"   # Remove config_ prefix

# Ensure directories exist before redirecting output
mkdir -p results logs

# Rename the Slurm job to reflect the config
scontrol update JobId="$SLURM_JOB_ID" JobName="sim_${CONFIG_ID}"

# Redirect stdout and stderr to config-specific log files
exec >"logs/sim_${CONFIG_ID}_${SLURM_JOB_ID}.out" \
     2>"logs/sim_${CONFIG_ID}_${SLURM_JOB_ID}.err"

echo "Job ID: $SLURM_JOB_ID"
echo "Job name: sim_${CONFIG_ID}"
echo "Config: $CONFIG_FILE"
echo "Start time: $(date)"

module load python
source .venv/bin/activate

# Parallelism settings
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

python -m src.run_simulation_script --config "$CONFIG_FILE"

echo "End time: $(date)"